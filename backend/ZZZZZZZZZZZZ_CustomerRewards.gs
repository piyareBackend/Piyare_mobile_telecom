/* PMT customer rewards: ledger-only, server-issued, idempotent order earn. */
function pmtCustomerRewardOrderEarn_(orderId){
  const sh=S('Orders');if(!sh)return;const h=sh.getRange(1,1,1,Math.max(10,sh.getLastColumn())).getValues()[0],cid=h.indexOf('customer_id');if(cid<0)return;const r=sh.getDataRange().getValues();let row=null;for(let i=1;i<r.length;i++)if(String(r[i][0])===String(orderId)){row=r[i];break}if(!row)return;const customerId=String(row[cid]||'');if(!customerId)return;const points=Math.max(0,Math.floor(Number(row[5]||0)/100));if(!points)return;const ledger=pmtCustomerEnsureSheet_('RewardsLedger',['reward_id','customer_id','type','reference_id','points','description','created_at']),lr=ledger.getDataRange().getValues();for(let i=1;i<lr.length;i++)if(String(lr[i][2])==='ORDER_EARN'&&String(lr[i][3])===String(orderId))return;ledger.appendRow(['RWD-'+Utilities.getUuid().slice(0,12).toUpperCase(),customerId,'ORDER_EARN',orderId,points,'Order reward',now_()]);pmtCustomerAudit_('reward_earn',customerId,{order_id:orderId,points});}
var PMT_BASE_UPDATE_ORDER_CUSTOMER_REWARD_=updateOrder_;
updateOrder_=function(p,session){const result=PMT_BASE_UPDATE_ORDER_CUSTOMER_REWARD_(p,session);try{const d=JSON.parse(result.getContent());if(d&&d.ok&&String(p&&p.status||'')==='Confirmed')pmtCustomerRewardOrderEarn_(p.id)}catch(e){}return result};
