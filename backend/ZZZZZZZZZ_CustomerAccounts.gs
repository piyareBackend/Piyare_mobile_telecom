function pmtCustomerWarranties_(s){const sh=S('Warranties');if(!sh)return pmtCustomerResponse_({ok:true,data:[]});const r=sh.getDataRange().getValues(),out=[];for(let i=1;i<r.length;i++)if(String(r[i][1])===String(s.customer_id))out.push({id:String(r[i][0]),orderId:String(r[i][2]),product:String(r[i][3]),reference:String(r[i][4]),startDate:String(r[i][5]),endDate:String(r[i][6]),status:String(r[i][7]),terms:String(r[i][8])});pmtCustomerAudit_('warranty_view',s.customer_id);return pmtCustomerResponse_({ok:true,data:out.reverse()})}
function pmtCustomerFavorites_(s){const sh=S('Favorites');if(!sh)return pmtCustomerResponse_({ok:true,data:[]});const products=productRows_(),map={};products.forEach(p=>map[p.id]=p);const r=sh.getDataRange().getValues(),out=[];for(let i=1;i<r.length;i++)if(String(r[i][1])===String(s.customer_id)){const p=map[String(r[i][2])];if(p)out.push({id:String(r[i][0]),productId:p.id,name:p.name,price:p.price,stock:p.stock,images:p.images,category:p.category})}return pmtCustomerResponse_({ok:true,data:out.reverse()})}
function pmtCustomerFavorite_(s,p,remove){p=p||{};const pid=pmtCustomerSafe_(p.product_id,120),ps=S('Products');if(!pid||!ps)return pmtCustomerResponse_({ok:false,error:'Product not found'});const pr=productRows_().find(x=>String(x.id)===pid);if(!pr||pr.status==='Archived'||pr.deletedAt)return pmtCustomerResponse_({ok:false,error:'Product not found'});const sh=S('Favorites');const r=sh.getDataRange().getValues();let found=-1;for(let i=1;i<r.length;i++)if(String(r[i][1])===String(s.customer_id)&&String(r[i][2])===pid){found=i+1;break}if(remove){if(found>0)sh.deleteRow(found);pmtCustomerAudit_('favorite_remove',s.customer_id,{product_id:pid});return pmtCustomerResponse_({ok:true})}if(found<0)sh.appendRow(['FAV-'+Utilities.getUuid().slice(0,12).toUpperCase(),s.customer_id,pid,now_()]);pmtCustomerAudit_('favorite_add',s.customer_id,{product_id:pid});return pmtCustomerResponse_({ok:true})}
