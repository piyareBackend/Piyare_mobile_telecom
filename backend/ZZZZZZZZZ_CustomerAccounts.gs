function pmtCustomerClaimCoupon_(s,p){const couponId=pmtCustomerSafe_(p&&p.coupon_id,120);const all=coupons_();let list=[];try{list=JSON.parse(all.getContent())?.data||[]}catch(e){}const coupon=list.find(x=>String(x.id)===couponId||String(x.code).toUpperCase()===String(couponId).toUpperCase());if(!coupon||!coupon.active)return pmtCustomerResponse_({ok:false,error:'Coupon is not available'});const sh=S('CustomerCoupons'),r=sh.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][1])===String(s.customer_id)&&String(r[i][2])===String(coupon.id)&&String(r[i][5]||'Claimed')!=='Used')return pmtCustomerResponse_({ok:false,error:'Coupon already claimed',code:'COUPON_ALREADY_CLAIMED'});sh.appendRow(['CC-'+Utilities.getUuid().slice(0,12).toUpperCase(),s.customer_id,coupon.id,now_(),'','Claimed']);pmtCustomerAudit_('coupon_claim',s.customer_id,{coupon_id:coupon.id});return pmtCustomerResponse_({ok:true,coupon})}
