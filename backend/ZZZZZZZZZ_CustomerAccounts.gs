function pmtCustomerReorder_(s,p){const orderId=pmtCustomerSafe_(p&&p.order_id,120),sh=S('Orders');if(!orderId||!sh)return pmtCustomerResponse_({ok:false,error:'Order not found'});const h=sh.getRange(1,1,1,Math.max(10,sh.getLastColumn())).getValues()[0],cid=h.indexOf('customer_id');if(cid<0)return pmtCustomerResponse_({ok:false,error:'Order is not linked to this account'});const r=sh.getDataRange().getValues();let row=null;for(let i=1;i<r.length;i++)if(String(r[i][0])===orderId&&String(r[i][cid])===String(s.customer_id)){row=r[i];break}if(!row)return pmtCustomerResponse_({ok:false,error:'Order not found'});let old=[];try{old=JSON.parse(String(row[4]||'[]'))}catch(e){}const products=productRows_(),map={};products.forEach(x=>map[x.id]=x);const available=[],unavailable=[];old.forEach(it=>{const p=map[String(it.id)],q=Math.max(1,Math.min(99,Number(it.qty)||1));if(!p||p.status==='Archived'||p.deletedAt||Number(p.stock||0)<=0)unavailable.push({id:String(it.id),name:String(it.name||it.id),reason:'Unavailable'});else{const v=(p.variants||[]).find(x=>String(x.id)===String(it.variantId||''));if(it.variantId&&(!v||Number(v.stock||0)<=0))unavailable.push({id:String(it.id),name:p.name,reason:'Variant unavailable'});else available.push({id:p.id,name:p.name,variantId:v?String(v.id):'',price:Number(v?.price??p.price??0),qty:Math.min(q,Math.max(1,Number(v?.stock??p.stock??0)))})}});pmtCustomerAudit_('reorder_start',s.customer_id,{order_id:orderId});return pmtCustomerResponse_({ok:true,orderId,available,unavailable})}
