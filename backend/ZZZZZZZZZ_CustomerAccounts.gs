function pmtCustomerResetPassword_(p){const raw=pmtCustomerSafe_(p&&p.token,200),password=String(p&&p.password||'');if(raw.length<40||password.length<10)return pmtCustomerResponse_({ok:false,error:'Invalid reset request',code:'CUSTOMER_RESET_INVALID'});const sh=S('CustomerIdentities'),r=sh.getDataRange().getValues(),hash=sha_(raw);for(let i=1;i<r.length;i++)if(String(r[i][13])===hash&&new Date(r[i][14]).getTime()>Date.now()){const salt=Utilities.getUuid(),newHash=pmtCustomerHash_(password,salt);sh.getRange(i+1,6).setValue(newHash);sh.getRange(i+1,7).setValue(salt);sh.getRange(i+1,14).setValue('');sh.getRange(i+1,15).setValue('');const cid=String(r[i][1]);pmtCustomerAudit_('recovery',cid);return pmtCustomerResponse_({ok:true,message:'Password updated. Please sign in again.'})}return pmtCustomerResponse_({ok:false,error:'Reset link is invalid or expired',code:'CUSTOMER_RESET_EXPIRED'})}
function pmtCustomerVerifyEmail_(p){const raw=pmtCustomerSafe_(p&&p.token,200);if(!raw)return pmtCustomerResponse_({ok:false,error:'Invalid verification link'});const sh=S('CustomerIdentities'),r=sh.getDataRange().getValues(),hash=sha_(raw);for(let i=1;i<r.length;i++)if(String(r[i][11])===hash&&new Date(r[i][12]).getTime()>Date.now()){sh.getRange(i+1,5).setValue(true);sh.getRange(i+1,12).setValue('');sh.getRange(i+1,13).setValue('');return pmtCustomerResponse_({ok:true,message:'Email verified'})}return pmtCustomerResponse_({ok:false,error:'Verification link is invalid or expired'})}
function pmtCustomerLinkExisting_(customerId,fieldName,identifier){const c=pmtCustomerRow_(customerId);if(!c)return;const sh=S(fieldName==='Orders'?'Orders':'Repairs');if(!sh)return;const h=sh.getRange(1,1,1,Math.max(fieldName==='Orders'?10:11,sh.getLastColumn())).getValues()[0],idx=h.indexOf('customer_id');if(idx<0)return;const phoneIdx=fieldName==='Orders'?3:3;const r=sh.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===String(identifier)&&!String(r[i][idx])){sh.getRange(i+1,idx+1).setValue(customerId);return}}
function pmtCustomerAttachCreated_(customerId,kind,id){try{pmtCustomerSchema_();pmtCustomerLinkExisting_(customerId,kind,id);if(kind==='Orders'){const c=pmtCustomerRow_(customerId);if(c){c.sheet.getRange(c.row,4).setValue(Number(c.data[3]||0)+1);c.sheet.getRange(c.row,5).setValue(now_());c.sheet.getRange(c.row,10).setValue(now_())}}}catch(e){auditSafe_('customer_link_error',String(e))}}
function pmtCustomerAdminDetail_(p,session){if(!session||!roleAllowed_(session,'Support'))return forbidden_();const id=pmtCustomerSafe_(p&&p.id,120),c=pmtCustomerRow_(id);if(!c)return J({ok:false,message:'Customer not found'});const profile=pmtCustomerPublicProfile_(id);const orders=pmtCustomerOrders_({customer_id:id});const repairs=pmtCustomerRepairs_({customer_id:id});let od=[],rd=[];try{od=JSON.parse(orders.getContent())?.data||[]}catch(e){}try{rd=JSON.parse(repairs.getContent())?.data||[]}catch(e){}return J({ok:true,customer:profile,orders:od,repairs:rd,warranties:JSON.parse(pmtCustomerWarranties_({customer_id:id}).getContent())?.data||[],rewards:JSON.parse(pmtCustomerRewards_({customer_id:id}).getContent())||{balance:0,ledger:[]},referrals:JSON.parse(pmtCustomerReferrals_({customer_id:id}).getContent())?.data||[]})}

/* ----- wrapper: this is the single effective customer-aware router ----- */
var PMT_PREV_CUSTOMER_DOGET=doGet;
var PMT_PREV_CUSTOMER_DOPOST=doPost;
doGet=function(e){
  try{
    const p=(e&&e.parameter)||{},a=clean_(p.action,80),s=pmtCustomerSession_(p.customer_token||p.token||'');
    if(a==='customerProfile')return s?pmtCustomerProfile_(s):forbidden_();
    if(a==='customerOrders')return s?pmtCustomerOrders_(s):forbidden_();
    if(a==='customerRepairs')return s?pmtCustomerRepairs_(s):forbidden_();
    if(a==='customerWarranties')return s?pmtCustomerWarranties_(s):forbidden_();
    if(a==='customerFavorites')return s?pmtCustomerFavorites_(s):forbidden_();
    if(a==='customerCoupons')return s?pmtCustomerCoupons_(s):forbidden_();
    if(a==='customerRewards')return s?pmtCustomerRewards_(s):forbidden_();
    if(a==='customerReferrals')return s?pmtCustomerReferrals_(s):forbidden_();
    if(a==='customerAdminDetail')return pmtCustomerAdminDetail_(p,auth_(p.token));
    return PMT_PREV_CUSTOMER_DOGET(e);
  }catch(err){return J({ok:false,error:String(err&&err.message||err),code:'CUSTOMER_ROUTE_ERROR'})}
};
doPost=function(e){
  let b={};try{b=JSON.parse((e&&e.postData&&e.postData.contents)||'{}')}catch(err){return J({ok:false,error:'Invalid request',code:'INVALID_JSON'})}
  const a=clean_(b.action,80),token=String(b.customer_token||b.token||''),s=pmtCustomerSession_(token);
  try{
    if(a==='customerSignup')return pmtCustomerCreate_(b.payload||{});
    if(a==='customerLogin')return pmtCustomerLogin_(b.payload||{});
    if(a==='customerLogout')return pmtCustomerLogout_(token);
    if(a==='customerRecoveryRequest')return pmtCustomerRecoveryRequest_(b.payload||{});
    if(a==='customerResetPassword')return pmtCustomerResetPassword_(b.payload||{});
    if(a==='customerVerifyEmail')return pmtCustomerVerifyEmail_(b.payload||{});
    if(a==='customerProfileUpdate')return s?pmtCustomerProfileUpdate_(s,b.payload||{}):forbidden_();
    if(a==='customerFavoriteAdd')return s?pmtCustomerFavorite_(s,b.payload||{},false):forbidden_();
    if(a==='customerFavoriteRemove')return s?pmtCustomerFavorite_(s,b.payload||{},true):forbidden_();
    if(a==='customerClaimCoupon')return s?pmtCustomerClaimCoupon_(s,b.payload||{}):forbidden_();
    if(a==='customerReferralCode')return s?pmtCustomerCreateReferralCode_(s):forbidden_();
    if(a==='customerReferralCreate')return s?pmtCustomerReferral_(s,b.payload||{}):forbidden_();
    if(a==='customerReorder')return s?pmtCustomerReorder_(s,b.payload||{}):forbidden_();
    if(a==='customerGrantReward')return (function(){if(!auth_(b.token)||!roleAllowed_(auth_(b.token),'Owner'))return forbidden_();const p=b.payload||{},cid=pmtCustomerSafe_(p.customer_id,120),pts=Math.round(Number(p.points)||0);if(!cid||!pts)return J({ok:false,error:'Invalid reward'});const sh=S('RewardsLedger');sh.appendRow(['RWD-'+Utilities.getUuid().slice(0,12).toUpperCase(),cid,p.type||'ADMIN_ADJUSTMENT',p.reference_id||'',pts,p.description||'Admin adjustment',now_()]);return J({ok:true})})();
    if(a==='createOrder'&&s){const out=PMT_PREV_CUSTOMER_DOPOST(e);try{const d=JSON.parse(out.getContent());if(d&&d.ok&&d.id)pmtCustomerAttachCreated_(s.customer_id,'Orders',d.id)}catch(x){}return out;}
    if(a==='createRepair'&&s){const out=PMT_PREV_CUSTOMER_DOPOST(e);try{const d=JSON.parse(out.getContent());if(d&&d.ok&&d.ticket)pmtCustomerAttachCreated_(s.customer_id,'Repairs',d.ticket)}catch(x){}return out;}
    return PMT_PREV_CUSTOMER_DOPOST(e);
  }catch(err){return J({ok:false,error:String(err&&err.message||err),code:err&&err.message==='Unauthorized'?'UNAUTHORIZED':'CUSTOMER_ROUTE_ERROR'})}
};

/* One-time additive migration. Safe to call repeatedly. */
function migrateCustomerAccounts(){pmtCustomerSchema_();const cs=S('Customers');if(!cs)return 'Customers sheet missing';const r=cs.getDataRange().getValues();for(let i=1;i<r.length;i++){const row=i+1,existing=String(r[i][5]||'').trim(),legacy=String(r[i][0]||'').trim();if(!existing){const cid=legacy&&/^CUS-/.test(legacy)?legacy:pmtCustomerId_();cs.getRange(row,6).setValue(cid);cs.getRange(row,9).setValue(r[i][4]||now_());cs.getRange(row,10).setValue(now_())}}
  const o=S('Orders');if(o){const h=o.getRange(1,1,1,Math.max(10,o.getLastColumn())).getValues()[0],idx=h.indexOf('customer_id'),phoneIdx=h.indexOf('phone'),nameIdx=h.indexOf('customer');if(idx>=0&&phoneIdx>=0){const cr=cs.getDataRange().getValues(),byPhone={};for(let i=1;i<cr.length;i++){const ph=String(cr[i][2]||'');if(ph&&!byPhone[ph])byPhone[ph]=String(cr[i][5]||'')}const rr=o.getDataRange().getValues();for(let i=1;i<rr.length;i++)if(!String(rr[i][idx])&&byPhone[String(rr[i][phoneIdx]||'')])o.getRange(i+1,idx+1).setValue(byPhone[String(rr[i][phoneIdx]||'')])}}
  const rep=S('Repairs');if(rep){const h=rep.getRange(1,1,1,Math.max(11,rep.getLastColumn())).getValues()[0],idx=h.indexOf('customer_id'),phoneIdx=h.indexOf('phone');if(idx>=0&&phoneIdx>=0){const cr=cs.getDataRange().getValues(),byPhone={};for(let i=1;i<cr.length;i++){const ph=String(cr[i][2]||'');if(ph&&!byPhone[ph])byPhone[ph]=String(cr[i][5]||'')}const rr=rep.getDataRange().getValues();for(let i=1;i<rr.length;i++)if(!String(rr[i][idx])&&byPhone[String(rr[i][phoneIdx]||'')])rep.getRange(i+1,idx+1).setValue(byPhone[String(rr[i][phoneIdx]||'')])}}
  return 'Customer account schema migration complete.';
}
