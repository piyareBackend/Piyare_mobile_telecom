/** Final zero-trust bridge compatibility and fail-closed fixes. */
ztPepper_=function(){const v=String(P('PMT_OTP_PEPPER')||P('PMT_SESSION_PEPPER')||'').trim();if(!v)throw new Error('OTP pepper is not configured');return v;};
ztAudit_=function(event,session,success,meta){meta=meta||{};ztAuditEvent_(event,session,success,meta.requestId||'',meta.safeMeta||{},meta.ip||'');};
function ztBridgeSheet_(){return ztSheet_('AdminBridgeTokens',['tokenHash','tokenId','adminId','username','createdAt','lastUsedAt','expiresAt','revokedAt']);}
function ztBridgeChallenge_(identity,requestId){const c=CacheService.getScriptCache(),cool='zt_bridge_otp_'+identity.userId;if(c.get(cool))return {ok:false,code:'OTP_COOLDOWN',message:'A verification code was recently sent. Please wait before requesting another.'};const challenge=token_(),otp=ztRand_(6),dest=ztDestination_(identity);if(!dest.email&&!dest.phone)return {ok:false,code:'OTP_DELIVERY_NOT_CONFIGURED',message:'OTP delivery is not configured for this administrator.'};c.put('zt_bridge_ch_'+challenge,JSON.stringify({adminId:identity.userId,hash:ztHashOtp_(challenge,otp),attempts:0,created:ztNowMs_()}),ZT_CFG.OTP_SECONDS);c.put(cool,challenge,ZT_CFG.OTP_RESEND_SECONDS);const sent=ztDeliverOtp_(dest,otp,'bridge_login');if(!sent.delivered){c.remove('zt_bridge_ch_'+challenge);c.remove(cool);return {ok:false,code:'OTP_DELIVERY_FAILED',message:'OTP delivery failed. Configure the trusted administrator notification channel.'};}ztAuditEvent_('bridge_otp_requested',identity,true,requestId,{channel:sent.channel},'');return {ok:true,challengeId:challenge,expiresIn:ZT_CFG.OTP_SECONDS,resendIn:ZT_CFG.OTP_RESEND_SECONDS};}
function ztBridgeCredentialLogin_(username,password,requestId){username=clean_(username,80);password=String(password||'');if(!username||password.length<10)return ztJson_({ok:false,message:'Invalid credentials'});const c=CacheService.getScriptCache(),key='zt_bridge_login_fail_'+ztB64_(username).slice(0,80),attempts=Number(c.get(key)||0);if(attempts>=ZT_CFG.MAX_LOGIN_ATTEMPTS)return ztJson_({ok:false,message:'Too many attempts. Try again later.',code:'LOGIN_RATE_LIMIT'});const s=pmtAccessEnsureSchema_(),r=s.getDataRange().getValues();let user=null;for(let i=1;i<r.length;i++)if(String(r[i][1]).trim().toLowerCase()===username.toLowerCase()){user=r[i];break;}if(!user||String(user[6]||'Active')!=='Active'||hash_(password,user[2])!==String(user[3])){c.put(key,String(attempts+1),ZT_CFG.LOGIN_WINDOW_SECONDS);ztAuditEvent_('bridge_login_failed',null,false,requestId,{username},'');return ztJson_({ok:false,message:'Invalid credentials'});}c.remove(key);const identity=ztIdentity_(String(user[0]));const ch=ztBridgeChallenge_(identity,requestId);return ch.ok?ztJson_({ok:true,otpRequired:true,challengeId:ch.challengeId,expiresIn:ch.expiresIn,resendIn:ch.resendIn}):ztJson_({ok:false,message:ch.message,code:ch.code});}
function ztBridgeOtpVerify_(challengeId,otp,requestId){const c=CacheService.getScriptCache(),key='zt_bridge_ch_'+String(challengeId||''),raw=c.get(key);if(!raw)return ztJson_({ok:false,message:'Code expired or invalid.',code:'OTP_INVALID'});let ch;try{ch=JSON.parse(raw)}catch(e){c.remove(key);return ztJson_({ok:false,message:'Code expired or invalid.',code:'OTP_INVALID'});}const n=Number(ch.attempts||0);if(n>=ZT_CFG.OTP_ATTEMPTS){c.remove(key);c.remove('zt_bridge_otp_'+String(ch.adminId));return ztJson_({ok:false,message:'Too many verification attempts. Request a new code.',code:'OTP_RATE_LIMIT'});}if(ztHashOtp_(challengeId,String(otp||''))!==String(ch.hash)){ch.attempts=n+1;c.put(key,JSON.stringify(ch),ZT_CFG.OTP_SECONDS);ztAuditEvent_('bridge_otp_failure',null,false,requestId,{reason:'invalid_code'},'');return ztJson_({ok:false,message:'Invalid verification code.',code:'OTP_INVALID'});}c.remove(key);c.remove('zt_bridge_otp_'+String(ch.adminId));const identity=ztIdentity_(String(ch.adminId));if(!identity)return ztJson_({ok:false,message:'Administrator is no longer active.',code:'ADMIN_INACTIVE'});const s=ztBridgeSheet_(),refresh=token_(),now=now_(),exp=new Date(ztNowMs_()+30*86400000),session=ztCreateSession_(identity,requestId);s.appendRow([sha_(refresh),ztB64_(refresh).slice(0,32),identity.userId,identity.username,now,'',exp,'']);ztAuditEvent_('bridge_login_success',identity,true,requestId,{},'');return ztJson_({ok:true,token:session.token,refreshToken:refresh,expiresIn:session.expiresIn,user:{id:identity.userId,name:identity.name,username:identity.username,role:identity.role,permissions:identity.permissions,avatarUrl:identity.avatarUrl}});}
function ztBridgeRefresh_(refreshToken,requestId){const token=String(refreshToken||'');if(token.length<40)return ztJson_({ok:false,message:'Bridge authorization is missing.',code:'BRIDGE_AUTH_REQUIRED'});const s=S('AdminBridgeTokens');if(!s)return ztJson_({ok:false,message:'Bridge authorization is not enrolled.',code:'BRIDGE_AUTH_REQUIRED'});const r=s.getDataRange().getValues(),now=ztNowMs_();let row=-1,data=null;for(let i=1;i<r.length;i++)if(String(r[i][0])===sha_(token)){row=i+1;data=r[i];break;}if(row<0||data[7]||new Date(data[6]).getTime()<=now)return ztJson_({ok:false,message:'Bridge authorization has expired or been revoked. Open the app and verify OTP again.',code:'BRIDGE_AUTH_EXPIRED'});const identity=ztIdentity_(String(data[2]||''));if(!identity)return ztJson_({ok:false,message:'Administrator is inactive.',code:'ADMIN_INACTIVE'});const newRefresh=token_(),session=ztCreateSession_(identity,requestId),exp=new Date(now+30*86400000);s.getRange(row,6).setValue(now_());s.getRange(row,8).setValue(now_());s.appendRow([sha_(newRefresh),ztB64_(newRefresh).slice(0,32),identity.userId,identity.username,now_(),'',exp,'']);ztAuditEvent_('bridge_token_rotated',identity,true,requestId,{},'');return ztJson_({ok:true,token:session.token,refreshToken:newRefresh,expiresIn:session.expiresIn});}
function ztBridgeLogout_(refreshToken,session,requestId){const s=S('AdminBridgeTokens');if(s&&refreshToken){const r=s.getDataRange().getValues(),h=sha_(String(refreshToken));for(let i=1;i<r.length;i++)if(String(r[i][0])===h&&!r[i][7])s.getRange(i+1,8).setValue(now_());}return session?ztInvalidateSession_(String(session.__token||''),session,requestId):ztJson_({ok:true});}
function ztBridgeRevokeOtherTokens_(adminId){const s=S('AdminBridgeTokens');if(!s)return;const r=s.getDataRange().getValues(),now=now_();for(let i=1;i<r.length;i++)if(!r[i][7]&&String(r[i][2])!==String(adminId))s.getRange(i+1,8).setValue(now);}
var ZT_BRIDGE_PREVIOUS_DOPOST=doPost;
doPost=function(e){let b={};try{b=JSON.parse((e&&e.postData&&e.postData.contents)||'{}')}catch(_){return ZT_BRIDGE_PREVIOUS_DOPOST(e)}const a=clean_(b.action,80),requestId=ztRequestId_();if(a==='adminBridgeLogin')return ztBridgeCredentialLogin_(b.username,b.password,requestId);if(a==='adminBridgeOtpVerify')return ztBridgeOtpVerify_(b.challengeId,b.otp,requestId);if(a==='adminBridgeRefresh')return ztBridgeRefresh_(b.refreshToken,requestId);if(a==='adminBridgeLogout'){const s=ztRefreshSession_(b.token);return ztBridgeLogout_(b.refreshToken,s,requestId)}if(a==='revokeAllSessions'&&b.token){const s=ztRefreshSession_(b.token);if(s&&ztCheckStepUp_(s,b.stepUpGrant))ztBridgeRevokeOtherTokens_(s.userId);}return ZT_BRIDGE_PREVIOUS_DOPOST(e)};
