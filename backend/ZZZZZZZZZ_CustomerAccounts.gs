/**
 * PMT Phase 2 — customer account system.
 * Additive layer over the existing Google Sheets + Apps Script backend.
 * Routing is wrapped here so the existing Code.gs doGet/doPost remains intact.
 */
const PMT_CUSTOMER_SESSION_SECONDS=21600;
const PMT_CUSTOMER_LOGIN_WINDOW_SECONDS=900;
const PMT_CUSTOMER_MAX_LOGIN_ATTEMPTS=8;
const PMT_CUSTOMER_RESET_SECONDS=1800;
const PMT_CUSTOMER_HASH_ITERATIONS=12000;
const PMT_CUSTOMER_SHEETS={
  identities:'CustomerIdentities',favorites:'Favorites',warranties:'Warranties',customerCoupons:'CustomerCoupons',
  rewards:'RewardsLedger',referrals:'Referrals'
};

function pmtCustomerEnsureSheet_(name,headers){
  let s=S(name);if(!s)s=DB().insertSheet(name);
  if(s.getLastRow()===0)s.getRange(1,1,1,headers.length).setValues([headers]);
  else if(s.getLastColumn()<headers.length){const h=s.getRange(1,1,1,headers.length).getValues()[0];for(let i=0;i<headers.length;i++)if(!h[i])h[i]=headers[i];s.getRange(1,1,1,headers.length).setValues([h]);}
  return s;
}
function pmtCustomerSchema_(){
  pmtCustomerEnsureSheet_('CustomerIdentities',['identity_id','customer_id','provider','email','email_verified','credential_hash','credential_salt','created_at','updated_at','last_login_at','status','verify_hash','verify_expires','recovery_hash','recovery_expires']);
  pmtCustomerEnsureSheet_('Favorites',['favorite_id','customer_id','product_id','created_at']);
  pmtCustomerEnsureSheet_('Warranties',['warranty_id','customer_id','order_id','product','serial_or_reference','start_date','end_date','status','terms','created_at','updated_at']);
  pmtCustomerEnsureSheet_('CustomerCoupons',['claim_id','customer_id','coupon_id','claimed_at','used_at','status']);
  pmtCustomerEnsureSheet_('RewardsLedger',['reward_id','customer_id','type','reference_id','points','description','created_at']);
  pmtCustomerEnsureSheet_('Referrals',['referral_id','referrer_customer_id','referred_customer_id','referral_code','status','reward_reference','created_at','completed_at']);
  const c=S('Customers');if(c){const headers=['id','name','phone','orders','lastActivity','customer_id','email','address','created_at','updated_at'];const h=c.getRange(1,1,1,Math.max(c.getLastColumn(),headers.length)).getValues()[0];for(let i=0;i<headers.length;i++)if(!h[i])h[i]=headers[i];c.getRange(1,1,1,headers.length).setValues([h]);}
  const o=S('Orders');if(o){const h=o.getRange(1,1,1,Math.max(o.getLastColumn(),10)).getValues()[0];if(!h[9])h[9]='customer_id';o.getRange(1,1,1,Math.max(o.getLastColumn(),10)).setValues([h]);}
  const r=S('Repairs');if(r){const h=r.getRange(1,1,1,Math.max(r.getLastColumn(),11)).getValues()[0];if(!h[10])h[10]='customer_id';r.getRange(1,1,1,Math.max(r.getLastColumn(),11)).setValues([h]);}
}
function pmtCustomerBytes_(s){return Utilities.computeHmacSha256Signature(String(s),String(P('PMT_CUSTOMER_PEPPER')||'PMT-CUSTOMER-V1'))}
function pmtCustomerHash_(password,salt){let v=Utilities.base64EncodeWebSafe(pmtCustomerBytes_(String(salt)+'\u0000'+String(password)));for(let i=1;i<PMT_CUSTOMER_HASH_ITERATIONS;i++)v=Utilities.base64EncodeWebSafe(pmtCustomerBytes_(v+'\u0000'+salt));return v.replace(/=+$/,'')}
function pmtCustomerEmail_(v){return String(v||'').trim().toLowerCase()}
function pmtCustomerSafe_(v,max){return clean_(v,max||CFG.MAX_TEXT)}
function pmtCustomerId_(){return 'CUS-'+Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase()}
function pmtCustomerIdentityId_(){return 'CID-'+Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase()}
function pmtCustomerToken_(){return token_()}
function pmtCustomerIdentityByEmail_(email){const s=S('CustomerIdentities');if(!s)return null;const r=s.getDataRange().getValues();const e=pmtCustomerEmail_(email);for(let i=1;i<r.length;i++)if(pmtCustomerEmail_(r[i][3])===e&&String(r[i][2]||'email')==='email')return{sheet:s,row:i+1,data:r[i]};return null}
function pmtCustomerIdentityById_(customerId){const s=S('CustomerIdentities');if(!s)return null;const r=s.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][1])===String(customerId))return{sheet:s,row:i+1,data:r[i]};return null}
function pmtCustomerRow_(customerId){const s=S('Customers');if(!s)return null;const r=s.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][5]||r[i][0])===String(customerId))return{sheet:s,row:i+1,data:r[i]};return null}
function pmtCustomerSession_(token){if(!token||String(token).length<40)return null;const raw=CacheService.getScriptCache().get('customer_session_'+token);if(!raw)return null;try{const s=JSON.parse(raw);if(!s||!s.customer_id)return null;return s;}catch(e){return null}}
function pmtCustomerSessionCreate_(customerId,identityId){const t=pmtCustomerToken_();CacheService.getScriptCache().put('customer_session_'+t,JSON.stringify({customer_id:String(customerId),identity_id:String(identityId),created_at:new Date().toISOString()}),PMT_CUSTOMER_SESSION_SECONDS);return t}
function pmtCustomerSessionInvalidate_(token){if(token)CacheService.getScriptCache().remove('customer_session_'+token)}
function pmtCustomerAuth_(b){return pmtCustomerSession_(b&&b.customer_token||b&&b.token||'')}
function pmtCustomerResponse_(d){return J(d)}
function pmtCustomerPublicProfile_(customerId){const x=pmtCustomerRow_(customerId);const id=pmtCustomerIdentityById_(customerId);if(!x||!id)return null;return{id:String(x.data[5]||customerId),name:String(x.data[1]||''),phone:String(x.data[2]||''),email:String(x.data[6]||id.data[3]||''),address:String(x.data[7]||'')}}
function pmtCustomerAudit_(event,customerId,meta){try{analyticsEvent_({event:'account_'+event,path:'/account',meta:{customer_id:String(customerId||''),...(meta||{})}})}catch(e){auditSafe_('customer_analytics_error',String(e))}}
function pmtCustomerCreate_(p){
  p=p||{};pmtCustomerSchema_();const email=pmtCustomerEmail_(p.email),password=String(p.password||''),name=pmtCustomerSafe_(p.name,80),phone=pmtCustomerSafe_(p.phone,10),address=pmtCustomerSafe_(p.address,500);
  if(!email_(email)||password.length<10||!name)return pmtCustomerResponse_({ok:false,error:'Invalid signup data',code:'CUSTOMER_SIGNUP_INVALID'});
  if(phone&&!phone_(phone))return pmtCustomerResponse_({ok:false,error:'Invalid phone',code:'CUSTOMER_PHONE_INVALID'});
  if(pmtCustomerIdentityByEmail_(email))return pmtCustomerResponse_({ok:false,error:'An account with this email already exists',code:'CUSTOMER_EMAIL_EXISTS'});
  const lock=LockService.getScriptLock();if(!lock.tryLock(15000))return pmtCustomerResponse_({ok:false,error:'Please retry',code:'CUSTOMER_BUSY'});
  try{
    if(pmtCustomerIdentityByEmail_(email))return pmtCustomerResponse_({ok:false,error:'An account with this email already exists',code:'CUSTOMER_EMAIL_EXISTS'});
    const cid=pmtCustomerId_(),iid=pmtCustomerIdentityId_(),salt=Utilities.getUuid(),hash=pmtCustomerHash_(password,salt),now=now_();
    const cs=S('Customers');if(!cs)throw Error('Customers sheet missing');
    cs.appendRow([cid,name,phone,0,now,cid,email,address,now,now]);
    const is=S('CustomerIdentities');is.appendRow([iid,cid,'email',email,false,hash,salt,now,now,'','Active','','','','']);
    const token=pmtCustomerSessionCreate_(cid,iid);pmtCustomerAudit_('signup',cid);return pmtCustomerResponse_({ok:true,customer:pmtCustomerPublicProfile_(cid),customer_token:token,expiresIn:PMT_CUSTOMER_SESSION_SECONDS,emailVerified:false});
  }catch(e){return pmtCustomerResponse_({ok:false,error:'Could not create account',code:'CUSTOMER_SIGNUP_FAILED'})}finally{lock.releaseLock()}
}
function pmtCustomerLogin_(p){
  p=p||{};pmtCustomerSchema_();const email=pmtCustomerEmail_(p.email),password=String(p.password||'');if(!email_(email)||!password)return pmtCustomerResponse_({ok:false,error:'Invalid credentials',code:'CUSTOMER_LOGIN_INVALID'});
  const key='customer_login_fail_'+Utilities.base64EncodeWebSafe(email).slice(0,80),cache=CacheService.getScriptCache(),attempts=Number(cache.get(key)||0);if(attempts>=PMT_CUSTOMER_MAX_LOGIN_ATTEMPTS)return pmtCustomerResponse_({ok:false,error:'Too many attempts. Try again later.',code:'CUSTOMER_LOGIN_RATE_LIMIT'});
  const found=pmtCustomerIdentityByEmail_(email);if(!found||String(found.data[10]||'Active')!=='Active'||pmtCustomerHash_(password,String(found.data[6]||''))!==String(found.data[5]||'')){cache.put(key,String(attempts+1),PMT_CUSTOMER_LOGIN_WINDOW_SECONDS);return pmtCustomerResponse_({ok:false,error:'Invalid credentials',code:'CUSTOMER_LOGIN_INVALID'})}
  cache.remove(key);const cid=String(found.data[1]),token=pmtCustomerSessionCreate_(cid,String(found.data[0]));found.sheet.getRange(found.row,10).setValue(now_());pmtCustomerAudit_('login',cid);return pmtCustomerResponse_({ok:true,customer:pmtCustomerPublicProfile_(cid),customer_token:token,expiresIn:PMT_CUSTOMER_SESSION_SECONDS,emailVerified:Boolean(found.data[4])});
}
function pmtCustomerLogout_(token){const s=pmtCustomerSession_(token);pmtCustomerSessionInvalidate_(token);if(s)pmtCustomerAudit_('logout',s.customer_id);return pmtCustomerResponse_({ok:true})}
function pmtCustomerRequire_(b){const s=pmtCustomerAuth_(b);if(!s)throw Error('Unauthorized');return s}
function pmtCustomerProfile_(s){return pmtCustomerResponse_({ok:true,customer:pmtCustomerPublicProfile_(s.customer_id)})}
function pmtCustomerProfileUpdate_(s,p){p=p||{};const c=pmtCustomerRow_(s.customer_id);if(!c)return pmtCustomerResponse_({ok:false,error:'Customer not found'});const email=pmtCustomerEmail_(p.email||'');if(email&&!email_(email))return pmtCustomerResponse_({ok:false,error:'Invalid email'});if(p.phone&&!phone_(String(p.phone)))return pmtCustomerResponse_({ok:false,error:'Invalid phone'});if(email){const other=pmtCustomerIdentityByEmail_(email);if(other&&String(other.data[1])!==String(s.customer_id))return pmtCustomerResponse_({ok:false,error:'Email already in use'});}
  const name=p.name!=null?pmtCustomerSafe_(p.name,80):String(c.data[1]||''),phone=p.phone!=null?pmtCustomerSafe_(p.phone,10):String(c.data[2]||''),address=p.address!=null?pmtCustomerSafe_(p.address,500):String(c.data[7]||'');c.sheet.getRange(c.row,2).setValue(name);c.sheet.getRange(c.row,3).setValue(phone);c.sheet.getRange(c.row,7).setValue(email||String(c.data[6]||''));c.sheet.getRange(c.row,8).setValue(address);c.sheet.getRange(c.row,10).setValue(now_());if(email){const id=pmtCustomerIdentityById_(s.customer_id);if(id)id.sheet.getRange(id.row,4).setValue(email)}pmtCustomerAudit_('profile_update',s.customer_id);return pmtCustomerResponse_({ok:true,customer:pmtCustomerPublicProfile_(s.customer_id)})}
function pmtCustomerOrders_(s){const sh=S('Orders');if(!sh)return pmtCustomerResponse_({ok:true,data:[]});const h=sh.getRange(1,1,1,Math.max(10,sh.getLastColumn())).getValues()[0],cid=h.indexOf('customer_id');if(cid<0)return pmtCustomerResponse_({ok:true,data:[]});const r=sh.getDataRange().getValues(),out=[];for(let i=1;i<r.length;i++)if(String(r[i][cid])===String(s.customer_id)){let items=[];try{items=JSON.parse(String(r[i][4]||'[]'))}catch(e){}out.push({id:String(r[i][0]),date:String(r[i][1]),items,total:Number(r[i][5]||0),payment:String(r[i][6]||''),status:String(r[i][7]||'Pending')})}pmtCustomerAudit_('order_history_view',s.customer_id);return pmtCustomerResponse_({ok:true,data:out.reverse()})}
