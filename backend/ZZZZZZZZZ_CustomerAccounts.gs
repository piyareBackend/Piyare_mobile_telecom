function pmtCustomerReferral_(s,p){const code=pmtCustomerSafe_(p&&p.referral_code,40).toUpperCase();if(!code)return pmtCustomerResponse_({ok:false,error:'Referral code is required'});const sh=S('Referrals'),r=sh.getDataRange().getValues();let found=null;for(let i=1;i<r.length;i++)if(String(r[i][3]).toUpperCase()===code){found=r[i];break}if(!found)return pmtCustomerResponse_({ok:false,error:'Referral code not found'});if(String(found[1])===String(s.customer_id))return pmtCustomerResponse_({ok:false,error:'Self-referral is not allowed'});for(let i=1;i<r.length;i++)if(String(r[i][2])===String(s.customer_id))return pmtCustomerResponse_({ok:false,error:'This account already has a referral'});const id='REF-'+Utilities.getUuid().slice(0,12).toUpperCase();sh.appendRow([id,found[1],s.customer_id,code,'Pending','',now_(),'']);pmtCustomerAudit_('referral_created',s.customer_id);return pmtCustomerResponse_({ok:true,referralId:id,status:'Pending'})}
function pmtCustomerReferrals_(s){const sh=S('Referrals'),r=sh.getDataRange().getValues(),out=[];for(let i=1;i<r.length;i++)if(String(r[i][1])===String(s.customer_id)||String(r[i][2])===String(s.customer_id))out.push({id:String(r[i][0]),referrerId:String(r[i][1]),referredId:String(r[i][2]),code:String(r[i][3]),status:String(r[i][4]),createdAt:String(r[i][6]),completedAt:String(r[i][7]||'')});return pmtCustomerResponse_({ok:true,data:out.reverse()})}
